<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 sticky top-20">
  <h3 class="text-sm font-semibold text-gray-900 mb-4">Search & Filter</h3>

  <%= search_form_for @q, url: jobs_path, html: { class: "space-y-4", data: { controller: "search", turbo_frame: "job_listings" } } do |f| %>
    <div>
      <label for="q_title_or_location_or_user_company_name_cont" class="block text-xs font-medium text-gray-600 mb-1">Search</label>
      <%= f.search_field :title_or_location_or_user_company_name_cont,
          class: "w-full rounded-md border-gray-300 text-sm px-3 py-2 border focus:border-indigo-500 focus:ring-indigo-500",
          placeholder: "Title, company, location...",
          data: { search_target: "input", action: "input->search#search" } %>
    </div>

    <div>
      <label for="category" class="block text-xs font-medium text-gray-600 mb-1">Category</label>
      <%= select_tag :category, options_for_select(@categories.map { |c| [c.name, c.slug] }, params[:category]),
          prompt: "All Categories",
          class: "w-full rounded-md border-gray-300 text-sm px-3 py-2 border",
          onchange: "this.form.requestSubmit()" %>
    </div>

    <div>
      <label for="job_type" class="block text-xs font-medium text-gray-600 mb-1">Job Type</label>
      <%= select_tag :job_type, options_for_select(Job.job_types.keys.map { |t| [t.humanize, t] }, params[:job_type]),
          prompt: "All Types",
          class: "w-full rounded-md border-gray-300 text-sm px-3 py-2 border",
          onchange: "this.form.requestSubmit()" %>
    </div>

    <div>
      <label for="salary_min" class="block text-xs font-medium text-gray-600 mb-1">Minimum Salary</label>
      <input type="number" name="salary_min" id="salary_min" value="<%= params[:salary_min] %>"
             class="w-full rounded-md border-gray-300 text-sm px-3 py-2 border focus:border-indigo-500 focus:ring-indigo-500"
             placeholder="e.g. 50000" step="10000"
             data-controller="salary-range"
             data-action="change->salary-range#update">
    </div>

    <% if params[:sort].present? %>
      <%= hidden_field_tag :sort, params[:sort] %>
    <% end %>

    <div class="flex space-x-2">
      <%= f.submit "Filter", class: "flex-1 px-3 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 cursor-pointer" %>
      <%= link_to "Clear", jobs_path, class: "flex-1 px-3 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200 text-center" %>
    </div>
  <% end %>
</div>
