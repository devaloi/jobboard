<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-4">
    <%= link_to "← Back to Jobs", jobs_path, class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-8">
      <div class="flex justify-between items-start mb-6">
        <div>
          <div class="flex items-center space-x-2 mb-2">
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= job_type_badge_class(@job.job_type) %>">
              <%= @job.job_type.humanize %>
            </span>
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-800">
              <%= @job.category.name %>
            </span>
          </div>

          <h1 class="text-3xl font-bold text-gray-900"><%= @job.title %></h1>

          <div class="mt-2 flex items-center space-x-4 text-gray-600">
            <span class="font-medium"><%= @job.company_name %></span>
            <span>📍 <%= @job.location %></span>
            <span>Posted <%= time_ago_in_words(@job.created_at) %> ago</span>
          </div>
        </div>

        <% if @job.salary_min.present? || @job.salary_max.present? %>
          <div class="text-right">
            <p class="text-2xl font-bold text-gray-900"><%= format_salary(@job.salary_min, @job.salary_max) %></p>
            <p class="text-sm text-gray-500">per year</p>
          </div>
        <% end %>
      </div>

      <% if @job.expires_at.present? %>
        <div class="mb-6 p-3 rounded-md bg-yellow-50 border border-yellow-200 text-sm text-yellow-800">
          Application deadline: <strong><%= @job.expires_at.strftime("%B %d, %Y") %></strong>
        </div>
      <% end %>

      <div class="prose max-w-none mb-8">
        <%= @job.body %>
      </div>

      <turbo-frame id="job_actions">
        <% if user_signed_in? && current_user.seeker? %>
          <div class="flex items-center space-x-4 border-t border-gray-200 pt-6">
            <% if @already_applied %>
              <span class="inline-flex items-center px-6 py-3 bg-green-100 text-green-800 text-sm font-medium rounded-md">
                ✓ Applied
              </span>
            <% else %>
              <%= form_with url: apply_job_path(@job), method: :post, class: "flex-1" do |f| %>
                <div class="mb-3">
                  <%= f.label :cover_letter, "Cover Letter (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= f.text_area :cover_letter, rows: 4, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border text-sm" %>
                </div>
                <%= f.submit "Apply Now", class: "px-6 py-3 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 cursor-pointer" %>
              <% end %>
            <% end %>

            <turbo-frame id="save_job_action">
              <% if @already_saved %>
                <%= button_to "♥ Saved", unsave_job_job_path(@job), method: :delete, class: "px-4 py-3 bg-red-100 text-red-700 text-sm font-medium rounded-md hover:bg-red-200" %>
              <% else %>
                <%= button_to "♡ Save", save_job_job_path(@job), method: :post, class: "px-4 py-3 bg-gray-100 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-200" %>
              <% end %>
            </turbo-frame>
          </div>
        <% elsif !user_signed_in? %>
          <div class="border-t border-gray-200 pt-6">
            <p class="text-gray-600 mb-3">Sign in to apply for this position.</p>
            <%= link_to "Log in", new_user_session_path, class: "inline-flex items-center px-6 py-3 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700" %>
          </div>
        <% end %>
      </turbo-frame>
    </div>
  </div>
</div>
