<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row gap-8">
    <!-- Sidebar filters -->
    <aside class="w-full md:w-64 flex-shrink-0">
      <%= render "search" %>
    </aside>

    <!-- Job listings -->
    <div class="flex-1">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Job Listings</h1>
        <div class="flex items-center space-x-2">
          <label for="sort" class="text-sm text-gray-600">Sort by:</label>
          <%= form_with url: jobs_path, method: :get, data: { turbo_frame: "job_listings" } do |f| %>
            <% params.except(:sort, :controller, :action).each do |key, value| %>
              <%= hidden_field_tag key, value %>
            <% end %>
            <%= select_tag :sort, options_for_select([["Newest", "newest"], ["Salary: High → Low", "salary_high"], ["Salary: Low → High", "salary_low"]], params[:sort]),
                class: "text-sm border-gray-300 rounded-md px-2 py-1 border", onchange: "this.form.requestSubmit()" %>
          <% end %>
        </div>
      </div>

      <turbo-frame id="job_listings">
        <% if @jobs.any? %>
          <div class="grid gap-4">
            <% @jobs.each do |job| %>
              <%= render "job", job: job %>
            <% end %>
          </div>

          <div class="mt-6">
            <%= pagy_nav_tag(@pagy) %>
          </div>
        <% else %>
          <div class="text-center py-12 bg-white rounded-lg shadow">
            <p class="text-gray-500">No jobs found matching your criteria.</p>
            <%= link_to "Clear filters", jobs_path, class: "text-indigo-600 hover:text-indigo-800 mt-2 inline-block" %>
          </div>
        <% end %>
      </turbo-frame>
    </div>
  </div>
</div>
