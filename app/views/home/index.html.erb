<div class="bg-gradient-to-br from-indigo-600 to-purple-700 text-white">
  <div class="max-w-7xl mx-auto px-4 py-24 text-center">
    <h1 class="text-5xl font-extrabold tracking-tight mb-4">Find Your Next Opportunity</h1>
    <p class="text-xl text-indigo-100 mb-8 max-w-2xl mx-auto">
      Connect with top employers and discover jobs that match your skills.
    </p>
    <%= link_to "Browse Jobs", jobs_path, class: "inline-block px-8 py-3 bg-white text-indigo-600 font-semibold rounded-lg shadow-md hover:bg-indigo-50 transition" %>
  </div>
</div>

<% if @categories.any? %>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Browse by Category</h2>
    <div class="flex flex-wrap gap-3">
      <% @categories.each do |category| %>
        <%= link_to jobs_path(category: category.slug), class: "inline-flex items-center px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-700 hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-700 transition shadow-sm" do %>
          <%= category.name %>
          <span class="ml-2 text-xs text-gray-400"><%= category.jobs_count %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @featured_jobs.any? %>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Recent Opportunities</h2>
      <%= link_to "View All →", jobs_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @featured_jobs.each do |job| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
          <div class="flex items-center space-x-2 mb-3">
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= job_type_badge_class(job.job_type) %>">
              <%= job.job_type.humanize %>
            </span>
            <span class="text-xs text-gray-500"><%= job.category.name %></span>
          </div>
          <%= link_to job_path(job), class: "block" do %>
            <h3 class="text-lg font-semibold text-gray-900 hover:text-indigo-600 transition"><%= job.title %></h3>
          <% end %>
          <div class="mt-2 text-sm text-gray-500">
            <p><%= job.company_name %> · 📍 <%= job.location %></p>
            <% if job.salary_min.present? || job.salary_max.present? %>
              <p class="mt-1 font-medium text-gray-700"><%= format_salary(job.salary_min, job.salary_max) %></p>
            <% end %>
          </div>
          <p class="mt-3 text-xs text-gray-400"><%= time_ago_in_words(job.created_at) %> ago</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
