<footer class="bg-white border-t border-gray-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="text-gray-500 text-sm">
        &copy; <%= Date.current.year %> JobBoard. Built with Rails & Tailwind CSS.
      </div>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <%= link_to "Browse Jobs", jobs_path, class: "text-gray-400 hover:text-gray-600 text-sm" %>
        <% unless user_signed_in? %>
          <%= link_to "Sign Up", new_user_registration_path, class: "text-gray-400 hover:text-gray-600 text-sm" %>
        <% end %>
      </div>
    </div>
  </div>
</footer>
