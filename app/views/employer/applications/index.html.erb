<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to My Listings", employer_jobs_path, class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Applications for "<%= @job.title %>"</h1>
      <p class="text-gray-500 mt-1"><%= @applications.size %> applicant(s)</p>
    </div>

    <div class="flex space-x-2">
      <%= link_to "All", employer_job_applications_path(@job), class: "px-3 py-1 rounded-md text-sm #{params[:status].blank? ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% JobApplication.statuses.keys.each do |s| %>
        <%= link_to s.humanize, employer_job_applications_path(@job, status: s), class: "px-3 py-1 rounded-md text-sm #{params[:status] == s ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% end %>
    </div>
  </div>

  <% if @applications.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Applicant</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cover Letter</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Applied</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Update</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" id="applications_list">
          <% @applications.each do |application| %>
            <%= render "application_row", application: application %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <p class="text-gray-500">No applications yet for this listing.</p>
    </div>
  <% end %>
</div>
