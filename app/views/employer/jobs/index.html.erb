<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">My Job Listings</h1>
    <%= link_to "Post New Job", new_employer_job_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition" %>
  </div>

  <% if @jobs.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Applications</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @jobs.each do |job| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= job.title %></div>
                <div class="text-sm text-gray-500"><%= job.location %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= job.category.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(job.status) %>">
                  <%= job.status.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= job.applications_count %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= link_to "Edit", edit_employer_job_path(job), class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to "View", job_path(job), class: "text-gray-600 hover:text-gray-900" %>
                <% if job.published? %>
                  <%= link_to "Applications", employer_job_applications_path(job), class: "text-green-600 hover:text-green-900" %>
                <% end %>
                <%= button_to "Archive", employer_job_path(job), method: :delete, class: "text-red-600 hover:text-red-900", data: { turbo_confirm: "Archive this listing?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <p class="text-gray-500 mb-4">You haven't posted any jobs yet.</p>
      <%= link_to "Post Your First Job", new_employer_job_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
